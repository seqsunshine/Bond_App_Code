<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preference_item_root"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="blocksDescendants">

    <TextView
        android:id="@+id/preference_name_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Preference Name"
        android:textSize="18sp"
        android:fontFamily="@font/bright_demo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/preference_description_text_view"
        android:layout_marginEnd="8dp"
        />

    <TextView
        android:id="@+id/preference_description_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Preference Description"
        android:textSize="18sp"
        android:fontFamily="@font/bright_demo"
        app:layout_constraintStart_toEndOf="@id/preference_name_text_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>